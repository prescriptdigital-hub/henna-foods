# Copy to .env.local for local testing, and add the same values in
# Vercel > henna-foods > Settings > Environment Variables for the live site.

# ---- Paystack (https://dashboard.paystack.com/#/settings/developers)
# Use the sk_test_ key while testing, then the sk_live_ key to take real payments.
PAYSTACK_SECRET_KEY=
# Your main address (defaults to https://www.hennafoods.com). Used for link previews,
# the sitemap and the Paystack return link.
NEXT_PUBLIC_SITE_URL=

# ---- Live chat box (WhatsApp). Optional override; the number normally lives in
# src/lib/site.ts. International format, digits only (e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Email via Resend (https://resend.com)
# Sends order alerts, contact form messages and newsletter sign-ups to TEAM_EMAIL.
# Without RESEND_API_KEY the contact form hands messages to WhatsApp or the visitor's email app.
RESEND_API_KEY=
# Inbox for alerts and messages (comma-separate several)
TEAM_EMAIL=
# Optional: separate inboxes for paid-order alerts and wholesale enquiries
ORDER_ALERT_EMAIL=
WHOLESALE_EMAIL_TO=
# A sender on a domain you have verified in Resend, e.g. Henna Foods <orders@hennafoods.com>.
# Until then Resend's test sender only delivers to the email you signed up to Resend with.
RESEND_FROM=
# Optional: Resend audience id; newsletter sign-ups are added to it instead of emailed
RESEND_AUDIENCE_ID=

# Order alerts also need the Paystack webhook. In Paystack: Settings > API Keys & Webhooks >
# Webhook URL: https://www.hennafoods.com/api/paystack/webhook
