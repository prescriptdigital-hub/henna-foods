# Copy to .env.local for local testing, and add the same values in
# Vercel > henna-foods > Settings > Environment Variables for the live site.

# ---- Paystack (https://dashboard.paystack.com/#/settings/developers)
# Use the sk_test_ key while testing, then the sk_live_ key to take real payments.
PAYSTACK_SECRET_KEY=
# Set to true only after Paystack has enabled USD on your account.
NEXT_PUBLIC_PAYSTACK_USD_ENABLED=false
# Your live address, used for Paystack's return link (e.g. https://henna-foods.vercel.app)
NEXT_PUBLIC_SITE_URL=

# ---- Live chat: Tawk.to (free). Dashboard > Administration > Chat Widget.
# From the widget link https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# ---- Live chat: WhatsApp button. International format, digits only (e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Wholesale enquiries by email via Resend (https://resend.com)
# Without these, the wholesale form opens the customer's email app instead.
RESEND_API_KEY=
WHOLESALE_EMAIL_TO=
# A sender on a domain you have verified in Resend, e.g. Henna Foods <orders@hennafoods.com>
RESEND_FROM=
